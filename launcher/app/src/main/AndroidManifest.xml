<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /></intent>
    </queries>
    <application android:label="sevOS" android:allowBackup="false" android:supportsRtl="false"
        android:hardwareAccelerated="true" android:theme="@style/CemTheme">
        <activity android:name=".HomeActivity" android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:screenOrientation="landscape" android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".KeystoneActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <activity android:name=".ProjectorActivity" android:exported="false"
            android:screenOrientation="landscape" />
        <receiver android:name=".SleepReceiver" android:exported="false" />
    </application>
</manifest>
